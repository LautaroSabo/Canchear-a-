{
  "name": "@cancheria/db",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "migrate": "node --env-file-if-exists=../../.env --import tsx src/cli/migrate.ts",
    "seed": "node --env-file-if-exists=../../.env --import tsx src/cli/seed.ts",
    "reset": "node --env-file-if-exists=../../.env --import tsx src/cli/reset.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.4",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
