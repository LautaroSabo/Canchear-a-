{
  "name": "cancheria",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --concurrency=1",
    "lint": "biome check .",
    "format": "biome check --write .",
    "dev": "turbo run dev --filter=@cancheria/api --filter=@cancheria/worker --filter=@cancheria/web",
    "demo:preparar": "pnpm db:migrate && pnpm db:seed && pnpm --filter @cancheria/api demo:usuario",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @cancheria/db migrate",
    "db:seed": "pnpm --filter @cancheria/db seed",
    "db:reset": "pnpm --filter @cancheria/db reset",
    "test:e2e": "pnpm --filter @cancheria/web test:e2e",
    "dev:web": "pnpm --filter @cancheria/web dev",
    "whatsapp:plantillas": "pnpm --filter @cancheria/worker whatsapp:plantillas"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "turbo": "2.11.10",
    "typescript": "7.0.2"
  }
}
