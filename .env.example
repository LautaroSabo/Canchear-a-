# Postgres local (docker compose). Los tests crean y borran sus propias bases temporales
# usando este mismo servidor, así que el usuario necesita permiso CREATEDB.
DATABASE_URL=postgres://cancheria:cancheria@localhost:5432/cancheria

# Clave AES-256 (32 bytes en base64) para cifrar las credenciales de Mercado Pago de
# cada club. Esta es SOLO para desarrollo; en producción generá otra y guardala como
# secreto:  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CLAVE_CREDENCIALES=Ddz48R/zoWlHo7wQ2nIZX4vI/0BD98rrnJT9vW+7jxY=

# URLs públicas: links en los mensajes, retorno desde Mercado Pago y webhooks.
URL_WEB=http://localhost:3000
URL_API=http://localhost:3001

# WhatsApp Cloud API (Meta). Sin esto, en desarrollo los mensajes se imprimen en consola.
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# Solo para `pnpm whatsapp:plantillas estado|crear`: ID de la cuenta de WhatsApp Business.
# WHATSAPP_WABA_ID=

# Aviso por mail cuando un club se registra (ver docs/publicar.md). Con Resend (HTTPS):
# AVISOS_EMAIL=tu@gmail.com
# RESEND_API_KEY=re_...
# O con Gmail por SMTP (contraseña de aplicación):
# SMTP_HOST=smtp.gmail.com
# SMTP_PUERTO=465
# SMTP_USUARIO=tu@gmail.com
# SMTP_CONTRASENA=
