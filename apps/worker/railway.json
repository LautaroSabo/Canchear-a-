{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK",
    "watchPatterns": ["apps/worker/**", "packages/**", "pnpm-lock.yaml"],
    "buildCommand": "pnpm --filter @cancheria/worker exec tsc --noEmit -p ."
  },
  "deploy": {
    "startCommand": "pnpm --filter @cancheria/worker start",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
